{
    "name": "ReviewDashboard",
    "version": "1.0.0",
    "author": "kyrie",
    "url": "",
    "descriptionmsg": "reviewdashboard-desc",
    "license-name": "GPL-2.0-or-later",
    "type": "specialpage",
    "SpecialPages": {
        "ReviewDashboard": "SpecialReviewDashboard"
    },
    "MessagesDirs": {
        "ReviewDashboard": ["i18n"]
    },
    "AutoloadClasses": {
        "SpecialReviewDashboard": "src/SpecialReviewDashboard.php"
    },
    "ResourceModules": {
        "ext.reviewdashboard": {
            "scripts": ["ext.reviewdashboard.js"],
            "styles": ["ext.reviewdashboard.css"],
            "messages": [
                "reviewdashboard-loading",
                "reviewdashboard-error",
                "reviewdashboard-success"
            ],
            "dependencies": [
                "jquery",
                "mediawiki.api"
            ]
        }
    },
    "ResourceFileModulePaths": {
        "localBasePath": "modules",
        "remoteExtPath": "ReviewDashboard/modules"
    },
    "GroupPermissions": {
        "junior-reviewer": {
            "reviewdashboard-access": true
        },
        "senior-reviewer": {
            "reviewdashboard-access": true,
            "reviewdashboard-senior": true
        },
        "review-admin": {
            "reviewdashboard-access": true,
            "reviewdashboard-senior": true,
            "reviewdashboard-admin": true
        }
    },
    "AvailableRights": [
        "reviewdashboard-access",
        "reviewdashboard-senior",
        "reviewdashboard-admin"
    ],
    "manifest_version": 2
}
